
<%- include('partials/header', { title: title }) %> 

<main class="page-container">
    <section class="planner-intro">
        <h1>Plan your trip</h1>

        <p>Tell us where your where you are going and what you enjoy or wish to explore!</p>
    </section>

    <section class="planner-structure">
        <div class="trip-form-container">
            <form action="/plan-trip" id="trip-form" method="POST">
                <label for="destination">Destination</label>
                
                <input
                    type="text"
                    id="destination"
                    name="destination"
                    placeholder="Example: Tokyo, Japan"
                    value="<%= formData ? formData.destination : '' %>"
                    required
                >

                <label for="duration">Duration (in days)</label>

                <input
                    type="number"
                    id="duration"
                    name="duration"
                    min="1"
                    max="30"
                    value="<%= formData ? formData.duration : '' %>"
                    required
                >
                
                <label for="interests">What are your interests? & What would you like to do during your trip? Please be as specific as possible.</label>
                <input
                    type="text"
                    id="interests"
                    name="interests"
                    placeholder="History, Food, Parks... "
                    value="<%= formData ? formData.interests : '' %>"
                    required
                >


                <button type="submit" class="primary-button">
                    Generate Itinerary
                </button>
            </form>
        </div>

        <div id="generated-trip">
            <% if (errorMessage) { %>
                <p class="error-message">
                    <%= errorMessage %>
                </p>
            <% } %>

            <% if (itinerary) { %>
                <section class="itinerary-result">
                    <h2><%= itinerary.tripName %></h2>

                    <p>
                        <strong>Destination:</strong> 
                        <%= itinerary.destination %>
                    </p>

                    <% itinerary.days.forEach(function(day) { %>
                        <article class="day-card">
                            <h3>
                            Day <%= day.day %>: <%= day.theme %>
                            </h3>

                            <section class="food-section">
                            <h4>Food Recommendations</h4>

                            <% day.foodPlaces.forEach(function(foodPlace) { %>
                                <div class="food-card">
                                <h5>
                                    <%= foodPlace.mealType %>: <%= foodPlace.locationName %>
                                </h5>

                                <p>
                                    <strong>Address:</strong>
                                    <%= foodPlace.address %>
                                </p>

                                <p><%= foodPlace.description %></p>

                                <a
                                    href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(foodPlace.searchQuery) %>"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    View on Google Maps
                                </a>
                                </div>
                            <% }) %>
                            </section>

                            <section class="places-section">
                            <h4>Places to Visit</h4>

                            <% day.placesToVisit.forEach(function(place) { %>
                                <div class="activity-card">
                                <h5><%= place.locationName %></h5>

                                <p>
                                    <strong>Address:</strong>
                                    <%= place.address %>
                                </p>

                                <p><%= place.description %></p>

                                <a
                                    href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(place.searchQuery) %>"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    View on Google Maps
                                </a>
                                </div>
                            <% }) %>
                            </section>
                        </article>
                        <% }) %>
                    <form action="/save-trip" method="POST">
                        <button type="submit" id="save-trip-button" class="save-button">
                            Save Trip
                        </button>
                    </form>
                </section>
            <% } else {%>
                <p>Your itinerary will appear here.</p>
            <% } %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>